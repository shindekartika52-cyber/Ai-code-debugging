# Gemini API key (SERVER-SIDE ONLY - never prefix with VITE_).
# Get one at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key

# MongoDB connection string.
# Local MongoDB:  mongodb://127.0.0.1:27017/debugsh
# Atlas:          mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/debugsh?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017/debugsh"
MONGODB_DB="debugsh"

# Express API port (the React dev server on 8080 proxies /api to it)
PORT=5000
